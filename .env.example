# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM provider (openai | anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Workflow limits
MAX_RETRY_COUNT=3
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_IMAGE=autopatch-sandbox:latest

# LangGraph checkpoint backend (memory | sqlite | redis)
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_URL=sqlite:///./data/checkpoints.db
REDIS_URL=redis://localhost:6379/0

# API resiliency
API_RETRY_ATTEMPTS=5
